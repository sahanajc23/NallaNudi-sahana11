<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- English Term + Bookmark -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemEnglish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Photosynthesis"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1a1408"/>

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/btn_star_big_off"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bookmark"/>

        </LinearLayout>

        <!-- Kannada Term -->
        <TextView
            android:id="@+id/tvItemKannada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ದ್ಯುತಿಸಂಶ್ಲೇಷಣೆ"
            android:textSize="15sp"
            android:textColor="#0d9488"
            android:layout_marginTop="2dp"/>

        <!-- Subject Tag -->
        <TextView
            android:id="@+id/tvItemSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Science"
            android:textSize="11sp"
            android:textColor="#7a6f5e"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>